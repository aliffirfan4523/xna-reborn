  "triggeredRules": [
    {
      "id": "FL001",
      "title": "Flixel 2.x library in use",
      "explanation": "The project uses the Flixel library. The converter maps org.flixel to a C# port of Flixel 2.x that is added to the migrated copy.",
      "resolution": "No action. The runtime project XnaReborn.Flixel is generated next to the game.",
      "migratorTask": "flash-to-monogame 13.2"
    },
    {
      "id": "FL020",
      "title": "\u0027with\u0027 statement",
      "explanation": "C# has no \u0027with\u0027 statement. The converter leaves a marker and the original text.",
      "resolution": "Rewrite the block with explicit member access.",
      "migratorTask": null
    },
    {
      "id": "FL021",
      "title": "E4X XML expressions",
      "explanation": "XML literals and E4X operators (.@, .., .( )) are not converted.",
      "resolution": "Rewrite with System.Xml.Linq.",
      "migratorTask": null
    },
    {
      "id": "FL022",
      "title": "\u0027arguments\u0027 object",
      "explanation": "The arguments object has no C# counterpart.",
      "resolution": "Use a rest parameter (params object[]).",
      "migratorTask": null
    },
    {
      "id": "FL023",
      "title": "Untyped variable or \u0027*\u0027 type",
      "explanation": "Untyped values become \u0027dynamic\u0027 in C#, which is slower and defers errors to run time.",
      "resolution": "Add a type annotation in the ActionScript, or accept \u0027dynamic\u0027.",
      "migratorTask": "flash-to-monogame 11.3"
    },
    {
      "id": "FL024",
      "title": "Dynamic class",
      "explanation": "A dynamic class can gain properties at run time. C# classes cannot.",
      "resolution": "Move the extra data into a dictionary or declared fields.",
      "migratorTask": null
    },
    {
      "id": "FL025",
      "title": "Namespace declaration or \u0027use namespace\u0027",
      "explanation": "AS3 namespaces and the :: operator have no direct C# form.",
      "resolution": "Replace with access modifiers or plain names.",
      "migratorTask": null
    },
    {
      "id": "FL026",
      "title": "Function values and closures",
      "explanation": "Function expressions and function-typed values become AsFunction.",
      "resolution": "No action.",
      "migratorTask": "flash-to-monogame 11.3"
    },
    {
      "id": "FL027",
      "title": "Integer division changes meaning",
      "explanation": "In AS3, dividing two ints gives a Number. In C# it gives an int. The converter casts the left operand to double.",
      "resolution": "No action.",
      "migratorTask": "flash-to-monogame 11.3"
    },
    {
      "id": "FL028",
      "title": "Number default is NaN",
      "explanation": "An AS3 Number without an initializer starts as NaN. C# doubles start as 0. The converter writes double.NaN.",
      "resolution": "No action.",
      "migratorTask": "flash-to-monogame 11.1"
    },
    {
      "id": "FL029",
      "title": "\u0027Object\u0027 used as a property bag",
      "explanation": "Object literals and indexed Object access become AsObject, a string keyed dictionary.",
      "resolution": "Check that no code relies on prototype features.",
      "migratorTask": "flash-to-monogame 11.3"
    },
    {
      "id": "FL030",
      "title": "Regular expression literal",
      "explanation": "Regular expression literals are not converted in the first slice.",
      "resolution": "Rewrite with System.Text.RegularExpressions.",
      "migratorTask": null
    },
    {
      "id": "FL031",
      "title": "Reflection by name",
      "explanation": "getDefinitionByName and ApplicationDomain look up classes by name at run time.",
      "resolution": "Replace with a table of class references.",
      "migratorTask": null
    },
    {
      "id": "FL040",
      "title": "flash.display used outside Flixel",
      "explanation": "Display list classes (Sprite, Bitmap, Stage) have no counterpart in the Flixel runtime.",
      "resolution": "Move the drawing into Flixel sprites.",
      "migratorTask": null
    },
    {
