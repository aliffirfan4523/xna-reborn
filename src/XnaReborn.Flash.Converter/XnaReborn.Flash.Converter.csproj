<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Converts Flash (AS3 + Flixel 2.x) source projects into a MonoGame project copy. Never modifies the original.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XnaReborn.Flash.Analyzer\XnaReborn.Flash.Analyzer.csproj" />
    <ProjectReference Include="..\XnaReborn.Migrator\XnaReborn.Migrator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Flixel runtime sources travel inside the converter and are written into every migrated copy. -->
    <EmbeddedResource Include="..\XnaReborn.Flixel\**\*.cs" Exclude="..\XnaReborn.Flixel\obj\**;..\XnaReborn.Flixel\bin\**" LogicalName="XnaReborn.Flixel/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\XnaReborn.Flixel\.editorconfig" LogicalName="XnaReborn.Flixel/.editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XnaReborn.Flash.Tests" />
  </ItemGroup>

</Project>
