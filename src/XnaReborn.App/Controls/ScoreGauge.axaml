<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shapes="using:Avalonia.Controls.Shapes"
             x:Class="XnaReborn.App.Controls.ScoreGauge">
  <!-- A ring that fills with the score. The numbers are printed too, so the ring is never the only cue. -->
  <StackPanel Spacing="{StaticResource SpacingMedium}" HorizontalAlignment="Left">
    <Panel Width="140" Height="140" HorizontalAlignment="Left">
      <Ellipse Stroke="{DynamicResource SystemAccentColor}" StrokeThickness="12" Opacity="0.2" />
      <shapes:Arc x:Name="ScoreArc"
                  Stroke="{DynamicResource SystemAccentColor}"
                  StrokeThickness="12"
                  StrokeLineCap="Round"
                  StartAngle="-90"
                  SweepAngle="0"
                  Margin="0" />
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="ScoreText" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock Text="out of 100" FontSize="12" HorizontalAlignment="Center" />
      </StackPanel>
    </Panel>
    <StackPanel x:Name="ProjectedPanel" Spacing="{StaticResource SpacingSmall}" Width="140">
      <TextBlock x:Name="ProjectedText" TextWrapping="Wrap" />
      <ProgressBar x:Name="ProjectedBar" Minimum="0" Maximum="100" Height="8"
                   AutomationProperties.AccessibilityView="Raw" />
    </StackPanel>
  </StackPanel>
</UserControl>
