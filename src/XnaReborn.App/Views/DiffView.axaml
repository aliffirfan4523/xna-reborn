<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XnaReborn.App.ViewModels"
             xmlns:c="using:XnaReborn.App.Controls"
             x:Class="XnaReborn.App.Views.DiffView"
             x:DataType="vm:DiffViewModel">
  <UserControl.KeyBindings>
    <!-- Same keys as Visual Studio: F8 next problem, Shift+F8 previous. -->
    <KeyBinding Gesture="F8" Command="{Binding NextMarkerCommand}" />
    <KeyBinding Gesture="Shift+F8" Command="{Binding PreviousMarkerCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <!-- A pressed-in look for the active choice of a two-button switch or a filter. Text and glyph say the same thing. -->
    <Style Selector="Button.secondary.active">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Button.secondary.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Button.secondary.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- The page fills the window, but never gets shorter than about 620 px (see DiffView.axaml.cs); below that it scrolls instead of overlapping. -->
  <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid x:Name="PageRoot" Margin="{StaticResource PagePadding}" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
    <TextBlock Grid.Row="0" Text="{Binding Title}" Classes="headline"
               AutomationProperties.HeadingLevel="1" />

    <!-- Dry run: nothing is written yet. -->
    <Border Grid.Row="1" IsVisible="{Binding IsDryRun}"
            AutomationProperties.AutomationId="DryRunBanner" AutomationProperties.Name="Preview, nothing written yet">
    <c:Banner Kind="Warning" Title="{Binding PreviewBanner}"
              Message="These are the changes a migration would make. No file has been written yet.">
      <Button Classes="secondary" Content="Back to Migration setup to run it for real"
              Command="{Binding BackToSetupCommand}"
              AutomationProperties.AutomationId="DiffBackToSetup"
              AutomationProperties.Name="Back to Migration setup to run it for real" />
    </c:Banner>
    </Border>

    <!-- Filter by change kind (one button per kind, with its count) and the view switch. -->
    <!-- Two columns, so the filter buttons wrap into the room the view switch leaves instead of pushing it off the page. -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <ItemsControl ItemsSource="{Binding KindCounts}" VerticalAlignment="Center"
                    AutomationProperties.AutomationId="KindCounts" AutomationProperties.Name="Files per kind">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DiffKindCount">
            <Button Classes="secondary" Classes.active="{Binding IsActive}" Margin="0,0,8,4"
                    Command="{Binding $parent[ItemsControl].((vm:DiffViewModel)DataContext).FilterByKindCommand}"
                    CommandParameter="{Binding Kind}"
                    AutomationProperties.Name="{Binding AccessibleName}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding Glyph}" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontWeight="Bold" />
                <TextBlock Text="{Binding Text}" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
        <Button Classes="secondary" Classes.active="{Binding IsSideBySide}" Content="Side by side"
                Command="{Binding ShowSideBySideCommand}"
                AutomationProperties.AutomationId="ViewSideBySide"
                AutomationProperties.Name="{Binding SideBySideName}" />
        <Button Classes="secondary" Classes.active="{Binding IsUnified}" Content="Unified"
                Command="{Binding ShowUnifiedCommand}"
                AutomationProperties.AutomationId="ViewUnified"
                AutomationProperties.Name="{Binding UnifiedName}" />
      </StackPanel>
    </Grid>

    <!-- The file list takes a third of the width, at most 300 px, so the diff keeps room in a small window. -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="140" MaxWidth="300" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Classes="card flat compact">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="{Binding FilesSummary}" Classes="section" VerticalAlignment="Center"
                       AutomationProperties.HeadingLevel="2" />
            <Button Classes="subtle" Content="Show all" IsVisible="{Binding IsFiltered}"
                    Command="{Binding ClearFilterCommand}"
                    AutomationProperties.AutomationId="DiffClearFilter"
                    AutomationProperties.Name="Show all files" />
          </StackPanel>
          <ListBox ItemsSource="{Binding VisibleFiles}" SelectedItem="{Binding SelectedFile}"
                   Background="Transparent"
                   AutomationProperties.AutomationId="DiffFiles" AutomationProperties.Name="Changed files">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DiffFileItem">
                <StackPanel Spacing="4" AutomationProperties.Name="{Binding AccessibleName}">
                  <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                  <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4">
                    <TextBlock Text="{Binding KindGlyph}" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontWeight="Bold" VerticalAlignment="Center" />
                    <c:Chip Kind="{Binding Status}" Text="{Binding KindLabel}" />
                    <c:Chip Kind="Warning" Text="{Binding MarkerText}" IsVisible="{Binding HasMarkers}" />
                  </WrapPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="8" Background="Transparent" ResizeDirection="Columns"
                    AutomationProperties.Name="Resize file list" />

      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*" RowSpacing="8">
        <!-- Sticky file header: it sits outside the scrolling panes, so it stays in view. -->
        <Border Grid.Row="0" Classes="card flat compact" IsVisible="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}"
                AutomationProperties.AutomationId="DiffFileHeader">
          <!-- One flat wrap panel, so every item can drop to the next line in a narrow window or at a large text size. -->
          <WrapPanel>
            <TextBlock Text="{Binding SelectedFile.Path}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" Margin="0,4,8,4"
                       AutomationProperties.AutomationId="DiffFilePath" />
            <c:Chip Kind="{Binding SelectedFile.Status}" Text="{Binding SelectedFile.KindLabel}" VerticalAlignment="Center" Margin="0,4,8,4" />
            <TextBlock Text="{Binding DiffStats}" Classes="caption muted" VerticalAlignment="Center" Margin="0,4,24,4"
                       FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                       AutomationProperties.AutomationId="DiffStats" AutomationProperties.Name="Lines added, removed and modified" />
            <TextBlock Text="{Binding MarkerStatus}" Classes="caption muted" VerticalAlignment="Center" Margin="0,4,8,4"
                       AutomationProperties.AutomationId="MarkerStatus" />
            <Button Classes="secondary" Content="Previous marker" Command="{Binding PreviousMarkerCommand}"
                    Margin="0,4,8,4"
                    ToolTip.Tip="Shift+F8"
                    AutomationProperties.AutomationId="PreviousMarker"
                    AutomationProperties.Name="Go to the previous manual-work marker" />
            <Button Classes="secondary" Content="Next marker" Command="{Binding NextMarkerCommand}"
                    Margin="0,4,0,4"
                    ToolTip.Tip="F8"
                    AutomationProperties.AutomationId="NextMarker"
                    AutomationProperties.Name="Go to the next manual-work marker" />
          </WrapPanel>
        </Border>

        <!-- Manual-work callout: the marker line you jumped to. -->
        <c:Banner Grid.Row="1" Kind="Warning" IsVisible="{Binding HasCurrentMarker}"
                  Title="Needs manual work" Message="{Binding CurrentMarkerText}"
                  AutomationProperties.AutomationId="MarkerCallout" />

        <Panel Grid.Row="2">
          <Border IsVisible="{Binding HasDiff}" Classes="card flat" Padding="0" ClipToBounds="True">
            <c:DiffViewer Diff="{Binding CurrentDiff}" Reveal="{Binding Reveal}" IsUnified="{Binding IsUnified}" IsVisible="{Binding HasDiff}"
                          AutomationProperties.AutomationId="DiffViewer" />
          </Border>
          <Border IsVisible="{Binding HasPlaceholder}" Classes="card flat"
                  AutomationProperties.AutomationId="DiffPlaceholder">
            <TextBlock Text="{Binding Placeholder}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
        </Panel>
      </Grid>
    </Grid>

    <DockPanel Grid.Row="4" LastChildFill="False">
      <Button Classes="secondary" DockPanel.Dock="Left" Content="Back to Migration setup" Command="{Binding BackToSetupCommand}"
              IsVisible="{Binding !IsDryRun}" AutomationProperties.AutomationId="DiffBack"
              AutomationProperties.Name="Back to Migration setup" />
      <Button Classes="primary" DockPanel.Dock="Right" Content="Continue to Build and run" Command="{Binding ContinueCommand}"
              AutomationProperties.AutomationId="DiffContinue"
              AutomationProperties.Name="Continue to Build and run" />
      <TextBlock DockPanel.Dock="Right" Margin="0,0,12,0" VerticalAlignment="Center" IsVisible="{Binding IsDryRun}"
                 Classes="muted" Text="Run the migration for real to continue." />
    </DockPanel>
  </Grid>
  </ScrollViewer>
</UserControl>
