<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Creates migrated MonoGame copies of XNA projects. Never modifies the original.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XnaReborn.Core\XnaReborn.Core.csproj" />
    <ProjectReference Include="..\XnaReborn.Analyzer\XnaReborn.Analyzer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Projects\packages.json" LogicalName="XnaReborn.Migrator.Projects.packages.json" />
    <EmbeddedResource Include="Content\data\xna-only-fonts.json" LogicalName="XnaReborn.Migrator.Content.xna-only-fonts.json" />
  </ItemGroup>

  <!-- The XACT shim is real C# so that tests compile and run it against MonoGame. The migrator embeds the files and writes them into a migrated copy. -->
  <ItemGroup>
    <Compile Remove="Shims\Xact\**" />
    <EmbeddedResource Include="Shims\Xact\*.cs" LogicalName="XnaReborn.Migrator.Shims.Xact.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DiffPlex" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XnaReborn.Tests" />
  </ItemGroup>

</Project>
