  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XnaReborn.Core\XnaReborn.Core.csproj" />
    <ProjectReference Include="..\XnaReborn.Analyzer\XnaReborn.Analyzer.csproj" />
